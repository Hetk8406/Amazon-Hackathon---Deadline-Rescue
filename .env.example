# Deadline Rescue - Environment Configuration Template
# Copy this file to .env.local for local overrides.
#
# SECURITY NOTE:
# Do NOT store production secrets, private tokens, or backend credentials here.
# Any variable prefixed with VITE_ is bundled into client-side JavaScript and is public.

# App environment mode (development | test | production)
VITE_APP_ENV=development

# Optional AI Adapter endpoint (if a server-side backend proxy is introduced in Phase 4)
# VITE_AI_PROXY_ENDPOINT=http://localhost:3001/api/assistant
